[Unit]
Description=NipoVPN dashboard
Documentation=https://github.com/MortezaBashsiz/nipovpn-dashboard
After=network-online.target nipovpn-server.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/nipovpn-dashboard --config /etc/nipovpn-dashboard/config.yaml
# Reload loads a renewed TLS certificate; other changes to the config need a restart.
ExecReload=/bin/kill -HUP $MAINPID
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
UMask=0077

# The dashboard runs as root because it edits the server's config, reads its
# log and usage file, and signals or restarts the server. Everything else is
# locked down.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

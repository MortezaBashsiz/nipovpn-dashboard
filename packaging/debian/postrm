#!/bin/sh
set -e

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    rm -rf /usr/lib/nipovpn-dashboard/__pycache__
fi

if [ "$1" = "purge" ]; then
    # Certificates made by `nipovpn-dashboard make-cert`.
    rm -f /etc/nipovpn-dashboard/dashboard.crt /etc/nipovpn-dashboard/dashboard.key
    rmdir /etc/nipovpn-dashboard 2>/dev/null || true
fi

exit 0
